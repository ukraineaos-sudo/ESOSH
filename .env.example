# Canonical deployment origin
NEXT_PUBLIC_SITE_URL=https://www.esosh.net
# Contact form: prefers Brevo (same keys below). Optional webhook fallback.
# CONTACT_ADMIN_EMAIL=office@esosh.net
# CONTACT_WEBHOOK_URL=
# CONTACT_WEBHOOK_TOKEN=

# Enrollment notifications (optional; falls back to CONTACT_WEBHOOK_*)
# ENROLLMENT_WEBHOOK_URL=
# ENROLLMENT_WEBHOOK_TOKEN=
# Enrollment file storage: default private. Set public only for local/dev Blob stores that lack private access.
# ENROLLMENT_BLOB_ACCESS=private
# ENROLLMENT_BLOB_ACCESS=public

# Brevo transactional email — enrollment + contact form admin alerts
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=office@esosh.net
# BREVO_SENDER_NAME=ESOSH
# ENROLLMENT_ADMIN_EMAIL=office@esosh.net
# (contact uses CONTACT_ADMIN_EMAIL or falls back to ENROLLMENT_ADMIN_EMAIL)

# Admin CMS (Neon + Blob)
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# BLOB_READ_WRITE_TOKEN=
# ADMIN_SESSION_SECRET=replace-with-long-random-string
# First admin user (created once if DB has no users). Login: username + password (not email).
# Defaults admin/admin — change immediately after first login; never leave in production.
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=admin
# Enforce «change bootstrap password before writes» (off by default for testing). Set to 1 to re-enable.
# ADMIN_ENFORCE_PASSWORD_CHANGE=1

# Cloudflare Turnstile (enrollment apply gate + server verify)
# Active only when NODE_ENV=production (skipped on `next dev` / localhost).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
